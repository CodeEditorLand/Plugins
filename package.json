{
  "name": "swc-plugins",
  "packageManager": "pnpm@10.4.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "test": "pnpm --filter @swc/* run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@swc/core": "^1.11.31",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.3"
  },
  "lint-staged": {
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ],
    "!(**/tests/**/*)*.js": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.ts": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.jsx": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.tsx": [
      "prettier --write"
    ]
  }
}
