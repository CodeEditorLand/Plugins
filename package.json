{
  "name": "swc-plugins",
  "packageManager": "pnpm@11.15.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "test": "pnpm --filter @swc/* run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@swc/core": "^1.15.43",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ],
    "!(**/tests/**/*)*.js": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.ts": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.jsx": [
      "prettier --write"
    ],
    "!(**/tests/**/*)*.tsx": [
      "prettier --write"
    ]
  }
}
